<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The local model helper (docs/conversation.md 11.2) reads the model through an inherited descriptor and answers
         on a Unix socket in its own container, which needs no entitlement: no files, no network. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
</dict>
</plist>
