#!/bin/sh
# Before every push: the test suites for what the push changes. There is no hosted CI, so this is the gate.
# Swift changes run ./scripts/test.sh (each test target is its own run; it ends with one line for all of them).
# Companion changes run companion/test.sh.
# Tests run against each pushed commit, never against whatever this checkout holds: in place only when the
# checkout is that commit with no uncommitted or untracked changes, otherwise in a temporary detached worktree.
# A push whose changes cannot be tested (the commit lacks the test script for what it changes) is rejected.
set -eu
cd "$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
work=$(mktemp -d "${TMPDIR:-/tmp}/sprava-pre-push.XXXXXX")
tree=""
cleanup() {
    [ -n "$tree" ] && git worktree remove --force "$tree" >/dev/null 2>&1 || true
    rm -rf "$work"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

fail() { echo "$1" >&2; echo "pre-push: nothing was pushed" >&2; exit 1; }

# Read every ref first: the tests must not consume the hook's standard input.
cat > "$work/refs"

swift_paths='^(Sources/|Tests/|Package\.swift$|scripts/test\.sh$)'
tested=""
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue                      # a deleted branch
    case " $tested " in *" $local_sha "*) continue ;; esac
    tested="$tested $local_sha"

    if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        base=$remote_sha
    else                                                        # a new branch, or a remote tip not fetched
        base=$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "")
    fi
    if [ -n "$base" ]; then
        git diff --name-only "$base" "$local_sha" > "$work/changed" || fail "pre-push: could not list the changes of $local_ref"
    else
        git ls-tree -r --name-only "$local_sha" > "$work/changed" || fail "pre-push: could not list the files of $local_ref"
    fi
    swift=0; companion=0
    grep -qE "$swift_paths" "$work/changed" && swift=1
    grep -q '^companion/' "$work/changed" && companion=1
    [ "$swift" -eq 0 ] && [ "$companion" -eq 0 ] && continue

    # Where the commit is checked out: here if this checkout is exactly that commit, else a temporary worktree.
    if [ "$(git rev-parse HEAD)" = "$local_sha" ] && [ -z "$(git status --porcelain --untracked-files=all)" ]; then
        dir=$(pwd)
    else
        tree="$work/tree"
        git worktree add --detach --quiet "$tree" "$local_sha" >/dev/null 2>&1 \
            || fail "pre-push: could not check out $local_ref ($local_sha) to test it"
        dir=$tree
    fi

    if [ "$swift" -eq 1 ]; then
        if [ -f "$dir/Package.swift" ] && [ -x "$dir/scripts/test.sh" ]; then
            out=$(cd "$dir" && unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX && ./scripts/test.sh 2>&1 </dev/null) || true
            echo "$out" | grep -q "^All test runs passed" \
                || fail "$(echo "$out" | grep -E "✘|error:|^Tests failed" | head -20)
pre-push: Swift tests failed for $local_ref"
            echo "$local_ref: $(echo "$out" | grep "^All test runs passed")" >&2
        elif [ -e "$dir/Package.swift" ] || [ -e "$dir/Sources" ] || [ -e "$dir/Tests" ]; then
            fail "pre-push: $local_ref changes Swift code but its commit has no Package.swift or executable scripts/test.sh to test it"
        fi
    fi
    if [ "$companion" -eq 1 ]; then
        if [ -x "$dir/companion/test.sh" ]; then
            out=$(cd "$dir" && unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX && companion/test.sh 2>&1 </dev/null) || fail "$(echo "$out" | tail -30)
pre-push: companion tests failed for $local_ref"
            echo "$local_ref: companion tests passed" >&2
        elif [ -e "$dir/companion" ]; then
            fail "pre-push: $local_ref changes companion/ but its commit has no executable companion/test.sh"
        fi
    fi

    if [ -n "$tree" ]; then
        git worktree remove --force "$tree" >/dev/null 2>&1 || true
        tree=""
    fi
done < "$work/refs"
exit 0
