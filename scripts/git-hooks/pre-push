#!/bin/sh
# Before every push: the test suites, run on every commit the push brings to the remote. There is no hosted CI,
# so this is the gate.
# The commits checked are those reachable from a pushed ref and not yet on the remote (not reachable from the
# remote's current tip for that ref, nor from any remote-tracking branch of that remote or of origin), oldest
# first. Which suites each one needs, where it runs, and the cache of trees that already passed (so a stack
# tested beforehand with scripts/git-hooks/test-tree.sh is not tested again) are described in suites.sh.
set -eu
hook_dir="$(cd "$(dirname "$0")" && pwd -P)"
cd "$(git rev-parse --show-toplevel)"
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX
remote="${1:-origin}"
zero=0000000000000000000000000000000000000000
work=$(mktemp -d "${TMPDIR:-/tmp}/sprava-pre-push.XXXXXX")
trap 'rm -rf "$work"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

fail() { echo "$1" >&2; echo "pre-push: nothing was pushed" >&2; exit 1; }
for lib in lock.sh suites.sh; do [ -r "$hook_dir/$lib" ] || fail "pre-push: $hook_dir/$lib is missing"; . "$hook_dir/$lib"; done

# Read every ref first: the tests must not consume the hook's standard input.
cat > "$work/refs"

# Every commit new to the remote, oldest first, once each even when several pushed refs share it.
: > "$work/all"
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue                      # a deleted ref
    set -- "$local_sha" --not --remotes="$remote" --remotes=origin
    if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        set -- "$@" "$remote_sha"
    fi
    git rev-list --reverse --topo-order "$@" > "$work/new" || fail "pre-push: could not list the commits of $local_ref"
    awk -v ref="$local_ref" '{ print $1, ref }' "$work/new" >> "$work/all"
done < "$work/refs"
awk '!seen[$1]++' "$work/all" > "$work/commits"

while read -r sha ref; do
    test_commit "$sha" "$ref" pre-push
done < "$work/commits"
total=$(wc -l < "$work/commits" | tr -d ' ')
[ "$total" -eq 0 ] || echo "pre-push: $total new commit(s): $suites_run suite run(s), $suites_cached already passed for the same tree, $commits_skipped commit(s) skipped (no Swift or companion changes)" >&2
exit 0
